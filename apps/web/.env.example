# Local development fallback; Vite also uses this value if present.
VITE_GAME_SERVER_URL=http://127.0.0.1:2567

# Local development fallback for wallet profiles. In production, Vercel must
# configure an HTTPS origin for the separately deployed platform API.
VITE_PLATFORM_API_URL=http://127.0.0.1:3000

# Production must set VITE_GAME_SERVER_URL in Vercel to the public HTTPS endpoint
# of the separately deployed authoritative game server.
# VITE_GAME_SERVER_URL=https://<persistent-game-server-host>
# The production profile API must be same-site so its HTTP-only session cookie
# remains available in modern browsers.
# VITE_PLATFORM_API_URL=https://api.blob.lat
