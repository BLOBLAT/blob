# Required whenever the platform API starts. Do not commit a real value.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public

# Local defaults are used only when NODE_ENV is not production.
PORT=3000
NODE_ENV=development
# PLATFORM_PUBLIC_ORIGIN=http://127.0.0.1:5173
# PLATFORM_WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Production values (set in the host dashboard; do not commit a real .env).
# PLATFORM_PUBLIC_ORIGIN=https://blob.lat
# PLATFORM_WEB_ORIGIN=https://blob.lat,https://www.blob.lat

# Production default: __Host-blob_session. A host-only Secure cookie is
# required in production; do not configure a non-__Host- name there.
# PLATFORM_SESSION_COOKIE_NAME=__Host-blob_session

# Process-local safety brake for wallet-sign-in requests. Keep an edge/WAF
# limit too when the API is public; these defaults work for a single replica.
# PLATFORM_AUTH_CHALLENGE_RATE_LIMIT=6
# PLATFORM_AUTH_VERIFY_RATE_LIMIT=12
# PLATFORM_AUTH_RATE_LIMIT_WINDOW_MS=600000

# Production-only 32-byte Ed25519 private key encoded as standard base64.
# It signs short-lived display-name tickets. Store it only in the platform API
# service; configure the corresponding public key on the game-server service.
PLATFORM_GAME_TICKET_PRIVATE_KEY_BASE64=

# Required only when verified paid-match entry and Rebuy Arena are enabled.
# Use a private HTTPS endpoint; never expose its credentials to Vite.
SOLANA_RPC_URL=https://<authenticated-solana-rpc-host>
# Native Solana USDC mint and the audited BLOB escrow program ID are deployment
# configuration, never browser input. Do not add placeholders to source code.
SOLANA_USDC_MINT=<native-solana-usdc-mint>
BLOB_ESCROW_PROGRAM_ID=<audited-escrow-program-id>

# Configure only when a separate paid-mode game room is deployed. This is a
# 32+ character server-to-server secret used to sign short-lived admission
# tickets after durable entry verification; it is never a Vite variable.
PLATFORM_GAME_SERVER_SHARED_SECRET=
