# Required whenever the platform API starts. Do not commit a real value.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public

# Local defaults are used only when NODE_ENV is not production.
PORT=3000
NODE_ENV=development
# PLATFORM_PUBLIC_ORIGIN=http://127.0.0.1:5173
# PLATFORM_WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Production values (set in the host dashboard; do not commit a real .env).
# PLATFORM_PUBLIC_ORIGIN=https://blob.lat
# PLATFORM_WEB_ORIGIN=https://blob.lat,https://www.blob.lat

# Production default: __Host-blob_session. A host-only Secure cookie is
# required in production; do not configure a non-__Host- name there.
# PLATFORM_SESSION_COOKIE_NAME=__Host-blob_session

# Process-local safety brake for wallet-sign-in requests. Keep an edge/WAF
# limit too when the API is public; these defaults work for a single replica.
# PLATFORM_AUTH_CHALLENGE_RATE_LIMIT=6
# PLATFORM_AUTH_VERIFY_RATE_LIMIT=12
# Shared process limit for each public wallet-auth route. Its short window is
# intentionally distinct from the per-wallet window below so a burst of new
# wallet values cannot lock every player out for ten minutes.
# PLATFORM_AUTH_GLOBAL_RATE_LIMIT=180
# PLATFORM_GLOBAL_RATE_LIMIT_WINDOW_MS=60000
# PLATFORM_AUTH_RATE_LIMIT_WINDOW_MS=600000

# Production-only 32-byte Ed25519 private key encoded as standard base64.
# It signs short-lived display-name tickets. Store it only in the platform API
# service; configure the corresponding public key on the game-server service.
PLATFORM_GAME_TICKET_PRIVATE_KEY_BASE64=
# The profile-ticket endpoint signs a new one-time arena identity only when a
# wallet-backed browser enters or reconnects. These process-local limits keep
# a valid session from becoming an unbounded signing workload.
# PLATFORM_GAME_TICKET_RATE_LIMIT=15
# PLATFORM_GAME_TICKET_GLOBAL_RATE_LIMIT=180

# Production arena-chat audit verifier. Configure this base58 Ed25519 public
# key only on platform-api. Its independent 32-byte private key belongs only
# to apps/game-server as BLOB_ARENA_CHAT_AUDIT_PRIVATE_KEY_BASE64. Never place
# either key in Vite or source control.
BLOB_ARENA_CHAT_AUDIT_PUBLIC_KEY_BASE58=
# Accepted chat audit records are purged after this many days (1–365).
# BLOB_CHAT_RETENTION_DAYS=90

# Required only when verified paid-match entry and Rebuy Arena are enabled.
# Use a private HTTPS endpoint; never expose its credentials to Vite.
SOLANA_RPC_URL=https://<authenticated-solana-rpc-host>
# Native Solana USDC mint and the audited BLOB escrow program ID are deployment
# configuration, never browser input. Do not add placeholders to source code.
SOLANA_USDC_MINT=<native-solana-usdc-mint>
BLOB_ESCROW_PROGRAM_ID=<audited-escrow-program-id>

# Reserved for a future paid-mode game room. This is a second, independent
# 32-byte Ed25519 private key encoded as standard base64; do not reuse the
# profile-ticket key and never expose either private key to Vite. Configuring
# this value does not enable Paid Mode or authorize a transfer.
PLATFORM_PAID_ADMISSION_TICKET_PRIVATE_KEY_BASE64=

# Reserved for the future separate Paid Room → Platform API consume request.
# This is only the public half of a third, independent Ed25519 pair. The
# matching private key belongs only to the future paid-room service and never
# to Vite, a wallet, or source control. Setting this does not enable Paid Mode.
BLOB_PAID_ADMISSION_CONSUMER_PUBLIC_KEY_BASE58=
