# Required whenever the platform API starts. Do not commit a real value.
DATABASE_URL=postgresql://<user>:<password>@<host>:5432/<database>?schema=public

# Local defaults are used only when NODE_ENV is not production.
PORT=3000
NODE_ENV=development
PLATFORM_WEB_ORIGIN=http://127.0.0.1:5173,http://localhost:5173

# Public production domain. This value is embedded into SIWS messages.
PLATFORM_PUBLIC_ORIGIN=https://blob.lat

# Required only when verified paid-match entry and Rebuy Arena are enabled.
# Use a private HTTPS endpoint; never expose its credentials to Vite.
SOLANA_RPC_URL=https://<authenticated-solana-rpc-host>
# Native Solana USDC mint and the audited BLOB escrow program ID are deployment
# configuration, never browser input. Do not add placeholders to source code.
SOLANA_USDC_MINT=<native-solana-usdc-mint>
BLOB_ESCROW_PROGRAM_ID=<audited-escrow-program-id>
