generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  generatedFileExtension = "ts"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum PaidMatchStatus {
  DRAFT
  OPEN
  FUNDING
  READY
  STARTING
  LIVE
  FINALIZING
  SETTLED
  CANCELLED
  REFUNDING
  REFUNDED
}

enum PaidRuleset {
  SKILL
  REBUY
}

enum EntryStatus {
  RESERVED
  PENDING
  VERIFIED
  CONSUMED
  REJECTED
  REFUNDING
  REFUNDED
}

enum ReviveStatus {
  OFFERED
  PAYMENT_PENDING
  VERIFIED
  PERMIT_ISSUED
  EXPIRED
  REJECTED
  CONSUMED
}

enum ChainTransactionKind {
  ENTRY
  REVIVE
  SETTLEMENT
  REFUND
}

enum PayoutKind {
  PRIZE
  PARTICIPATION_REBATE
}

/// Only server-accepted messages are retained. The browser never queries this
/// audit table directly; name and text are immutable snapshots for review.
enum ArenaChatMessageStatus {
  VISIBLE
  HIDDEN
  REMOVED
}

/// Referral points are application credits only. They are never a token,
/// currency, balance of custody assets, or a promise of future value.
enum ReferralPointReason {
  REFERRER_QUALIFIED_PLAYER
  REFEREE_QUALIFIED_PLAYER
  ADMIN_ADJUSTMENT
}

enum ReferralAttributionStatus {
  PENDING
  QUALIFIED
  BLOCKED
}

enum ReferralQualificationKind {
  FREE_ROUND_COMPLETED
}

model User {
  id                  String       @id @default(uuid())
  displayName         String
  displayNameKey      String
  renamedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  wallets             Wallet[]
  sessions            Session[]
  entries             MatchEntry[]
  deaths              DeathEvent[]
  reviveRequests      ReviveRequest[]
  auditEvents         AuditEvent[]
  arenaChatMessages   ArenaChatMessageAudit[]
  referralCode        ReferralCode?
  referralsMade       ReferralAttribution[] @relation("ReferralAttributionReferrer")
  referralReceived    ReferralAttribution?  @relation("ReferralAttributionReferee")
  referralQualifications ReferralQualification[]
  referralPoints      ReferralPointsLedger[]

  @@unique([displayNameKey])
}

model Wallet {
  id                  String       @id @default(uuid())
  address             String       @unique
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  verifiedAt          DateTime
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  entries             MatchEntry[]
  reviveRequests      ReviveRequest[]
}

model AuthChallenge {
  id                  String       @id @default(uuid())
  walletAddress       String
  nonce               String       @unique
  nonceHash           String
  messageHash         String
  expiresAt           DateTime
  consumedAt          DateTime?
  createdAt           DateTime     @default(now())

  @@index([walletAddress, expiresAt])
}

model Session {
  id                  String       @id @default(uuid())
  tokenHash           String       @unique
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletAddress       String
  expiresAt           DateTime
  createdAt           DateTime     @default(now())
  revokedAt           DateTime?

  @@index([userId, expiresAt])
  @@index([walletAddress, expiresAt])
}

model Match {
  id                    String            @id
  roundId               String            @unique
  status                PaidMatchStatus   @default(DRAFT)
  ruleset               PaidRuleset
  rulesVersion          String
  rulesHash             String
  settlementAsset       String
  usdcMint              String
  entryAmountBaseUnits  BigInt
  reviveAmountBaseUnits BigInt            @default(0)
  maxRevivesPerPlayer   Int               @default(0)
  reviveWindowMs        Int               @default(0)
  reviveCutoffMs        Int               @default(0)
  reviveSpawnProtectionMs Int              @default(0)
  platformFeeBps        Int
  participationRebateBps Int
  payoutBps             Int[]
  minimumPlayers        Int
  maximumPlayers        Int
  roundDurationMs       Int               @default(600000)
  fundingDeadline       DateTime
  startsAt              DateTime?
  endsAt                DateTime?
  escrowAddress         String            @unique
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  entries               MatchEntry[]
  deaths                DeathEvent[]
  reviveRequests        ReviveRequest[]
  chainTransactions     ChainTransaction[]
  result                MatchResult?
  settlementAttempts    SettlementAttempt[]
  payouts               Payout[]

  @@index([status, fundingDeadline])
}

model MatchEntry {
  id                  String       @id @default(uuid())
  matchId             String
  match               Match        @relation(fields: [matchId], references: [id], onDelete: Restrict)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId            String
  wallet              Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  playerId            String
  status              EntryStatus  @default(RESERVED)
  amountBaseUnits     BigInt
  idempotencyKey      String       @unique
  admissionTokenHash  String?      @unique
  admissionIssuedAt   DateTime?
  admissionExpiresAt  DateTime?
  transactionId       String?      @unique
  transaction         ChainTransaction? @relation("EntryTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  fundedAt            DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  deaths              DeathEvent[]
  reviveRequests      ReviveRequest[]
  payouts             Payout[]

  @@unique([matchId, userId])
  @@unique([matchId, playerId])
  @@index([matchId, status])
}

/// Frozen server result plus the exact result-derived payout plan. It is
/// created before any settlement side effect and cannot be replaced with a
/// different result for the same match.
model MatchResult {
  id                String            @id @default(uuid())
  matchId           String            @unique
  match             Match             @relation(fields: [matchId], references: [id], onDelete: Restrict)
  roundId           String            @unique
  rulesHash         String
  resultHash        String            @unique
  resultPayload     Json
  finalizedAt       DateTime
  createdAt         DateTime          @default(now())
  settlementAttempt SettlementAttempt?
  payouts           Payout[]
}

model DeathEvent {
  id                  String       @id
  matchId             String
  match               Match        @relation(fields: [matchId], references: [id], onDelete: Restrict)
  entryId             String
  entry               MatchEntry   @relation(fields: [entryId], references: [id], onDelete: Restrict)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  occurredAt          DateTime
  reviveExpiresAt     DateTime
  reviveCutoffAt      DateTime
  createdAt           DateTime     @default(now())
  reviveRequests      ReviveRequest[]

  @@index([matchId, entryId, occurredAt])
}

model ReviveRequest {
  id                  String       @id @default(uuid())
  matchId             String
  match               Match        @relation(fields: [matchId], references: [id], onDelete: Restrict)
  entryId             String
  entry               MatchEntry   @relation(fields: [entryId], references: [id], onDelete: Restrict)
  userId              String
  user                User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  walletId            String
  wallet              Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  deathId             String
  death               DeathEvent   @relation(fields: [deathId], references: [id], onDelete: Restrict)
  status              ReviveStatus @default(OFFERED)
  amountBaseUnits     BigInt
  expiresAt           DateTime
  permitHash          String?      @unique
  idempotencyKey      String       @unique
  transactionId       String?      @unique
  transaction         ChainTransaction? @relation("ReviveTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@unique([entryId, deathId])
  @@index([matchId, status, expiresAt])
}

model ChainTransaction {
  id                  String                @id @default(uuid())
  matchId             String
  match               Match                 @relation(fields: [matchId], references: [id], onDelete: Restrict)
  kind                ChainTransactionKind
  signature           String                @unique
  amountBaseUnits     BigInt
  walletAddress       String
  confirmedAt         DateTime?
  finalizedAt         DateTime?
  verificationError   String?
  idempotencyKey      String                @unique
  createdAt           DateTime              @default(now())
  entry               MatchEntry?          @relation("EntryTransaction")
  reviveRequest       ReviveRequest?       @relation("ReviveTransaction")
  settlementAttempt   SettlementAttempt?   @relation("SettlementTransaction")
  payouts             Payout[]             @relation("PayoutTransaction")

  @@index([matchId, kind, finalizedAt])
}

model SettlementAttempt {
  id                  String       @id @default(uuid())
  matchId             String
  match               Match        @relation(fields: [matchId], references: [id], onDelete: Restrict)
  resultId            String       @unique
  result              MatchResult  @relation(fields: [resultId], references: [id], onDelete: Restrict)
  resultHash          String
  settlementId        String       @unique
  idempotencyKey      String       @unique
  transactionId       String?      @unique
  transaction         ChainTransaction? @relation("SettlementTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  attemptedAt         DateTime     @default(now())
  settledAt           DateTime?
  error               String?

  @@index([matchId, settledAt])
  // A match result is immutable. Retries update this one durable attempt,
  // rather than creating another settlement authority path.
  @@unique([matchId])
}

model Payout {
  id                  String       @id @default(uuid())
  matchId             String
  match               Match        @relation(fields: [matchId], references: [id], onDelete: Restrict)
  resultId            String
  result              MatchResult  @relation(fields: [resultId], references: [id], onDelete: Restrict)
  entryId             String
  entry               MatchEntry   @relation(fields: [entryId], references: [id], onDelete: Restrict)
  kind                PayoutKind
  place               Int?
  amountBaseUnits     BigInt
  transactionId       String?
  transaction         ChainTransaction? @relation("PayoutTransaction", fields: [transactionId], references: [id], onDelete: SetNull)
  idempotencyKey      String       @unique
  createdAt           DateTime     @default(now())

  // PostgreSQL permits multiple NULL values here, so prize places remain
  // unique while every non-podium entry can retain its own rebate record.
  @@unique([matchId, place])
  // A player receives exactly one result-derived payout: prize or rebate.
  @@unique([matchId, entryId])
  @@index([entryId])
}

model AuditEvent {
  id                  String       @id @default(uuid())
  userId              String?
  user                User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  action              String
  entityType          String
  entityId            String
  requestId           String?
  metadata            Json?
  createdAt           DateTime     @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([userId, createdAt])
}

model ArenaChatMessageAudit {
  id                   String                 @id
  roomId               String
  matchId              String?
  roundId              String?
  profileUserId        String?
  profileUser          User?                  @relation(fields: [profileUserId], references: [id], onDelete: SetNull)
  anonymousAuthorKey   String?
  authorName           String
  text                 String
  status               ArenaChatMessageStatus @default(VISIBLE)
  sentAt               DateTime
  expiresAt            DateTime
  createdAt            DateTime               @default(now())

  @@index([roomId, sentAt])
  @@index([matchId, roundId, sentAt])
  @@index([profileUserId, sentAt])
  @@index([expiresAt])
}

/// An opaque public code. The wallet address is intentionally never placed in
/// a referral URL; the signed BLOB profile owns this code instead.
model ReferralCode {
  id        String   @id @default(uuid())
  code      String   @unique
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  revokedAt DateTime?

  attributions ReferralAttribution[]

  @@index([revokedAt])
}

/// A referee can be attributed once. The database uniqueness constraint—not
/// browser state—enforces the first-valid-referrer rule under concurrent links.
model ReferralAttribution {
  id              String                     @id @default(uuid())
  referralCodeId  String
  referralCode    ReferralCode               @relation(fields: [referralCodeId], references: [id], onDelete: Restrict)
  referrerUserId  String
  referrer        User                       @relation("ReferralAttributionReferrer", fields: [referrerUserId], references: [id], onDelete: Restrict)
  refereeUserId   String                     @unique
  referee         User                       @relation("ReferralAttributionReferee", fields: [refereeUserId], references: [id], onDelete: Restrict)
  status          ReferralAttributionStatus  @default(PENDING)
  capturedAt      DateTime                   @default(now())
  qualifiedAt     DateTime?
  blockedAt       DateTime?

  qualifications  ReferralQualification[]
  pointEntries    ReferralPointsLedger[]

  @@index([referrerUserId, status])
  @@index([referralCodeId, status])
}

/// A signed game-server fact that makes a referral reward eligible. It is
/// separate from the ledger so rule changes cannot rewrite completed history.
model ReferralQualification {
  id                    String                    @id @default(uuid())
  attributionId         String
  attribution           ReferralAttribution       @relation(fields: [attributionId], references: [id], onDelete: Restrict)
  refereeUserId         String
  referee               User                      @relation(fields: [refereeUserId], references: [id], onDelete: Restrict)
  kind                  ReferralQualificationKind
  matchId               String
  roundId               String
  qualifiedAt           DateTime
  sourceEventId         String                    @unique
  createdAt             DateTime                  @default(now())

  pointEntries          ReferralPointsLedger[]

  /// First completed Free round is enough for the initial program.
  @@unique([refereeUserId, kind])
  @@unique([refereeUserId, matchId, roundId, kind])
  @@index([attributionId, qualifiedAt])
}

/// Append-only integer point ledger. Balances are derived server-side; no
/// client request can write, edit, or redeem entries.
model ReferralPointsLedger {
  id                    String              @id @default(uuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  delta                 BigInt
  reason                ReferralPointReason
  referralAttributionId String?
  referralAttribution   ReferralAttribution? @relation(fields: [referralAttributionId], references: [id], onDelete: Restrict)
  qualificationId       String?
  qualification         ReferralQualification? @relation(fields: [qualificationId], references: [id], onDelete: Restrict)
  idempotencyKey        String              @unique
  metadata              Json?
  createdAt             DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([referralAttributionId])
  @@index([qualificationId])
}
