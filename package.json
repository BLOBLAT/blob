{
  "name": "blob",
  "version": "0.1.0",
  "private": true,
  "description": "BLOB — eat, grow, survive.",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run build",
    "dev:web": "npm run dev --workspace=@blob/web",
    "typecheck": "npm run typecheck --workspaces --if-present"
  }
}
