{
  "name": "blob",
  "version": "0.1.0",
  "private": true,
  "description": "BLOB — eat, grow, survive.",
  "packageManager": "npm@11.8.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0 <23",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "concurrently --kill-others-on-fail --names web,server --prefix-colors magenta,cyan \"npm run dev:web\" \"npm run dev:server\"",
    "dev:web": "npm run dev --workspace=@blob/web",
    "dev:server": "npm run dev --workspace=@blob/game-server",
    "start": "npm run start --workspace=@blob/game-server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "vitest": "4.1.10"
  }
}
